SEARXNG_BASE_URL=https://localhost:8080

# LLM provider: "llamacpp" (default) or "openrouter"
LLM_PROVIDER=llamacpp

# llama.cpp settings
LLAMA_CPP_BASE_URL=https://localhost:8081

# Primary remote provider (OpenAI-compatible; OpenRouter by default).
# OPENROUTER_MODEL accepts a comma-separated list; on 429 the client waits
# 5s and walks to the next model.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Backup provider: used when every primary model hits its rate limit.
OPENROUTER_BASE_URL1=https://openrouter.ai/api
OPENROUTER_API_KEY1=
OPENROUTER_MODEL1=nvidia/nemotron-3.5-lightning:free

# Google Books API (fallback when Open Library fails)
GOOGLE_BOOKS_API_KEY=

# Discogs (POST /lookup/discogs): CD barcode lookup, metadata only (no price).
# Create a free personal access token at
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=PriceReg/1.0
DISCOGS_TIMEOUT_SECONDS=10

# Bookstore + laya flow (POST /lookup/bookstore)
BOOKSTORE_BASE_URL=https://www.estantevirtual.com.br
BOOKSTORE_TIMEOUT_SECONDS=20
BOOKSTORE_MAX_CANDIDATES=20
# Minimum P(yes) for a listing to count as a match (0-1); keep it strict
LAYA_MATCH_THRESHOLD=0.9
# laya checkpoint pinned per predict call
LAYA_MODEL=multilingual
